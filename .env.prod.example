# Server config. Copy to `.env` (gitignored), fill in the four CHANGE_ME
# values, and every compose command works with no flags:
#
#   docker compose up -d --build
#
# COMPOSE_FILE below is what makes that work — compose reads this file
# automatically and switches to the production stack, so nothing on the server
# needs `-f docker-compose.prod.yml` or `--env-file`.
COMPOSE_FILE=docker-compose.prod.yml

# Differences from the dev `.env`: no *_PORT keys (nothing is published to the
# host) and no DATABASE_URL/REDIS_URL (compose builds them from the service
# names), plus TUNNEL_TOKEN at the bottom.

# ---------------------------------------------------------------------------
# Postgres — compose assembles DATABASE_URL from these, pointing at the
# `postgres` service on the internal network.
# ---------------------------------------------------------------------------
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=CHANGE_ME_long_random_string
POSTGRES_DB=chatbot

# ---------------------------------------------------------------------------
# Admin basic auth. This guards the whole admin API; `admin/admin` behind a
# public hostname is an open door, so change it AND put Cloudflare Access in
# front of the admin hostname.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_long_random_string

# Only needed for third-party browser clients calling the API cross-origin. The
# admin UI does NOT need an entry here: it calls /api/* on its own origin and
# the frontend proxies it to the backend internally, so CORS never applies.
CORS_ORIGINS=

# Webhook rate limiting (fixed window, per minute). A per-key override wins over
# RATE_LIMIT_PER_MINUTE; RATE_LIMIT_SESSION_PER_MINUTE applies per
# (api key, session_id) pair.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_SESSION_PER_MINUTE=20

# Ollama host — must be reachable from inside the container. `localhost` here
# means the container itself, not the server; use a hostname or a LAN IP.
OLLAMA_BASE_URL=https://ollama.example.com

# Embeddings — deployment-wide, not per-agent: ingestion and knowledge search
# must share one vector space, so both use the settings below.
#   EMBEDDING_PROVIDER : ollama | openai (any OpenAI-compatible /embeddings)
#   EMBEDDING_BASE_URL : blank -> OLLAMA_BASE_URL, or https://api.openai.com/v1
#   EMBEDDING_DIM      : must equal the Vector() column width. Not a knob —
#                        changing model dimension needs an Alembic migration
#                        AND a re-ingest of every document.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Conversation history: server-managed messages loaded per run, and the cap on
# a client-supplied `history` array.
CHAT_HISTORY_LIMIT=20
MAX_CLIENT_HISTORY_MESSAGES=200

# ---------------------------------------------------------------------------
# Deploy-only
# ---------------------------------------------------------------------------
# Note: there is no frontend API-URL setting. The frontend image carries no
# deployment config — it proxies /api/* to http://api:8000 internally, wired in
# docker-compose.prod.yml as BACKEND_INTERNAL_URL.
#
# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> copy the token.
# Routing (hostname -> service) is configured there, not in this repo.
TUNNEL_TOKEN=CHANGE_ME
