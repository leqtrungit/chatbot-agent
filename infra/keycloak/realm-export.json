{
  "realm": "harness",
  "enabled": true,
  "registrationAllowed": false,
  "organizationsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "operator",
        "composite": false,
        "clientRole": false,
        "containerId": "harness",
        "attributes": {},
        "description": "Platform operator — create and manage organizations"
      }
    ]
  },
  "clients": [
    {
      "clientId": "admin-ui",
      "name": "Admin UI",
      "description": "Frontend admin application",
      "enabled": true,
      "publicClient": true,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*",
        "oauth2.device.code.lifespan": "600",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "authenticationFlowBindingOverrides": {},
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "email",
        "roles",
        "acr",
        "organizations",
        "audience"
      ],
      "optionalClientScopes": [
        "address",
        "phone"
      ],
      "protocolMappers": [],
      "access": {
        "view": true,
        "configure": true,
        "manage": true
      }
    },
    {
      "clientId": "backend",
      "name": "Backend API",
      "description": "Backend service for token verification",
      "enabled": true,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "authenticationFlowBindingOverrides": {},
      "redirectUris": [],
      "webOrigins": [],
      "notBefore": 0,
      "bearerOnly": true,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "email",
        "roles",
        "acr"
      ],
      "optionalClientScopes": [
        "address",
        "phone"
      ],
      "protocolMappers": [],
      "access": {
        "view": true,
        "configure": true,
        "manage": true
      }
    },
    {
      "clientId": "seed-cli",
      "name": "Seed CLI",
      "description": "Development-only client for seed script and local testing (password grant enabled)",
      "enabled": true,
      "publicClient": true,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {},
      "authenticationFlowBindingOverrides": {},
      "redirectUris": [],
      "webOrigins": [],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "audience"
      ],
      "optionalClientScopes": [
        "address",
        "phone"
      ],
      "protocolMappers": [],
      "access": {
        "view": true,
        "configure": true,
        "manage": true
      }
    }
  ],
  "clientScopeMappings": {},
  "clientScopes": [
    {
      "name": "organizations",
      "description": "Organization membership claims",
      "protocol": "openid-connect",
      "attributes": {
        "consent.screen.text": "Access to organization information",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "organization",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "audience",
      "description": "Audience for backend service",
      "protocol": "openid-connect",
      "attributes": {
        "consent.screen.text": "",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "backend",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
