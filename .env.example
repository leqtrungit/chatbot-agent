# ---------------------------------------------------------------------------
# docker compose only (postgres / pgadmin / redis containers)
# ---------------------------------------------------------------------------
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
POSTGRES_PORT=5432

PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Backend (app/core/config.py). Values below must match POSTGRES_PORT/REDIS_PORT
# above when running the API/worker locally instead of in docker.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379/0

# Admin basic auth (admin UI + /api/domains, /api/agents, ...)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# CORS (comma-separated origins allowed to call the backend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Webhook rate limiting (fixed window, per minute). A per-key override wins over
# RATE_LIMIT_PER_MINUTE; RATE_LIMIT_SESSION_PER_MINUTE applies per
# (api key, session_id) pair.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_SESSION_PER_MINUTE=20

# Ollama host — fallback for ollama agents that leave base_url blank, and for
# embeddings when EMBEDDING_BASE_URL is empty. OpenAI agents carry their own
# base_url/api_key, set per-agent via the admin UI.
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings — deployment-wide, not per-agent: ingestion and knowledge search
# must share one vector space, so both use the settings below.
#   EMBEDDING_PROVIDER : ollama | openai (any OpenAI-compatible /embeddings)
#   EMBEDDING_BASE_URL : blank -> OLLAMA_BASE_URL, or https://api.openai.com/v1
#   EMBEDDING_DIM      : must equal the Vector() column width. Not a knob —
#                        changing model dimension needs an Alembic migration
#                        AND a re-ingest of every document (vectors from a
#                        different model are not comparable). If the model's
#                        output width disagrees, ingestion marks the document
#                        `failed` with an explicit message instead of letting
#                        Postgres reject the insert opaquely.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Conversation history: server-managed messages loaded per run, and the cap on
# a client-supplied `history` array.
CHAT_HISTORY_LIMIT=20
MAX_CLIENT_HISTORY_MESSAGES=200
