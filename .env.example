# Copy to `.env` and adjust. One file for both dev and a server — the last
# section is the only part that differs. Every key is read by something: docker
# compose (first section) or `Settings` in `backend/app/core/config.py` (the
# rest). Nothing dead, nothing missing.
#
# Nothing is needed for the frontend: it calls /api/* on its own origin and
# proxies internally, so no API hostname is configured anywhere.

# ---------------------------------------------------------------------------
# docker compose only (postgres / pgadmin / redis / keycloak containers)
# ---------------------------------------------------------------------------
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
POSTGRES_PORT=5432

PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

REDIS_PORT=6379

KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# ---------------------------------------------------------------------------
# Backend (app/core/config.py). Values below must match POSTGRES_PORT/REDIS_PORT
# above when running the API/worker locally instead of in docker.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379/0

# Keycloak
KEYCLOAK_ISSUER=http://localhost:8080/realms/harness
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/harness/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=backend

# CORS (comma-separated origins allowed to call the backend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Server only — leave this alone for local development.
#
# Uncommenting COMPOSE_FILE switches every `docker compose` command to the
# production stack, so the server needs no `-f` / `--env-file` flags:
#
#     cp .env.example .env     # fill in the values above
#     docker compose up -d --build
#
# The production stack builds DATABASE_URL and REDIS_URL from POSTGRES_* and
# the internal service names, so the localhost values above stay dev-only and
# the *_PORT keys go unused there. It publishes api on :8000 and frontend on
# :3000; ingress in front of those is not configured here.
#
# Change POSTGRES_PASSWORD and KEYCLOAK_DB_PASSWORD before exposing anything.
# ---------------------------------------------------------------------------
# COMPOSE_FILE=docker-compose.prod.yml
