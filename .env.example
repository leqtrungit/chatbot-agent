# Copy to `.env` and adjust. One file for both dev and docker compose.
# Every key is read by something: docker compose (first section) or `Settings`
# in `backend/app/core/config.py` (the rest). Nothing dead, nothing missing.

# ---------------------------------------------------------------------------
# docker compose only (postgres / pgadmin / redis / keycloak containers)
# ---------------------------------------------------------------------------
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
POSTGRES_PORT=5432

PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

REDIS_PORT=6379

KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# ---------------------------------------------------------------------------
# Backend API (app/core/config.py). When running locally (not in docker):
# - DATABASE_URL and REDIS_URL must match POSTGRES_PORT/REDIS_PORT above
# - KEYCLOAK_ISSUER and KEYCLOAK_JWKS_URL may differ in host:port for local dev
#
# When running in docker compose, the stack automatically wires these via
# service names (postgres, redis, keycloak), so changing the values above
# is sufficient; the container environment uses the wired connections.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379/0

# Embedding (LLM provider and vector store for knowledge ingestion/search)
EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Chat history and context limits
CHAT_HISTORY_LIMIT=20
MAX_CLIENT_HISTORY_MESSAGES=200

# Keycloak (identity & access management)
# NOTE: KEYCLOAK_ISSUER uses localhost (where browser fetches token),
#       KEYCLOAK_JWKS_URL uses keycloak (container-internal hostname).
#       These MUST differ in docker environments — it's not a typo.
KEYCLOAK_ISSUER=http://localhost:8080/realms/harness
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/harness/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=backend

# CORS (comma-separated origins allowed to call the backend API)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Local dev only — adjust when running API/worker on the host.
# For docker compose, ignore these and use the docker-compose.yml defaults.
# ---------------------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
# OLLAMA_BASE_URL=http://localhost:11434
